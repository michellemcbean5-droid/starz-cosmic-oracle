# Precision astrology engine (server/) — Swiss Ephemeris backend.
# EXPO_PUBLIC_ prefix required so Expo exposes it to client code.
# Defaults to http://localhost:8420 for local dev if unset.
EXPO_PUBLIC_EPHEMERIS_API_URL=http://localhost:8420

REVENUECAT_IOS_KEY=appl_YOUR_REVENUECAT_IOS_KEY
REVENUECAT_ANDROID_KEY=goog_YOUR_REVENUECAT_ANDROID_KEY
ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~NNNNNNNNNN
ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~NNNNNNNNNN
HF_API_TOKEN=hf_YOUR_HUGGINGFACE_TOKEN
MASTER_ACCESS_CODE=STARZ-ELITE-2024
EXPO_TOKEN=your_expo_token_for_ci
